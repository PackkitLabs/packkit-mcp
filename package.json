{
  "name": "packkit-mcp",
  "version": "1.0.0",
  "mcpName": "io.github.PackkitJS/packkit-mcp",
  "description": "MCP server for Packkit — let AI agents scaffold and upgrade modern projects in any supported language (JS/TS, Python) as a native tool.",
  "type": "module",
  "bin": {
    "packkit-mcp": "server.js"
  },
  "files": [
    "server.js",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PackkitJS/packkit-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "scaffold",
    "generator",
    "npm-package",
    "python",
    "packkit",
    "ai",
    "agent"
  ],
  "author": "DanMat <dannymatthew@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/PackkitJS/packkit-mcp#readme",
  "scripts": {
    "sync:mcp": "node scripts/sync-mcp-version.mjs",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run sync:mcp -- --check && npm run smoke",
    "changeset": "changeset",
    "version": "changeset version && npm run sync:mcp",
    "release": "changeset publish",
    "start": "node server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@packkit/core": "^0.1.3",
    "create-packkit": "^4.0.0",
    "create-packkit-py": "^1.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0"
  }
}
